// FER Employee Onboarding — Prisma schema
// Runs on DigitalOcean Managed Postgres in both dev and production; DATABASE_URL
// points at a dev database locally and the production one on App Platform.
// Enums are modeled as String for portability (validated in app code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// An employee record. Created either by an onboarding link or by Excel import.
model Employee {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Core identity
  firstName String?
  lastName  String?
  email     String?
  phone     String?

  // Sensitive — stored encrypted-at-rest target later; plain for Phase 1 dev
  ssn String? // Social Security Number

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zip          String?

  // Compliance fields
  driversLicenseNumber String?
  safetyCouncilId      String? // Safety Council ID / card number
  safetyCouncilExpiry  DateTime?
  twicNumber           String? // TWIC card number
  twicExpiry           DateTime?

  // Project Lead managed fields
  site     String? // job site / location
  active   Boolean @default(true)
  archived Boolean @default(false) // hidden from the grid by default once set

  // Project Lead / Project Manager assigned at onboarding-link creation;
  // both notified on completion.
  projectLeadEmail    String?
  projectManagerEmail String?
  // The staff user who generated this employee's onboarding link. A Project
  // Lead/Manager sees the employees they created plus those assigned to them.
  // Null for records created before this was tracked (or via Excel import).
  createdById String?

  // Rate info (set by Project Lead in Phase 3; placeholder now)
  payRate  Float?
  billRate Float?

  // Project Lead post-onboarding details. Booleans are nullable = "not set yet".
  hireDate           DateTime?
  frcNeeded          Boolean? // does the employee need FRC?
  frcSize            String? // FRC size when needed
  creditCardApproved Boolean? // company credit card approved?
  emailNeeded        Boolean? // does the employee need a company email?

  // Project Lead job assignment details
  urgency                    String? // URGENT | NON_URGENT
  employmentType             String? // comma-separated: Full Time, Part Time, 1099 Employee, Benefits, No Benefits
  positionType               String? // comma-separated: Administrative, Field Personnel, Supervision, Management
  directSupervisor           String?
  jobNumber                  String?
  jobSite                    String? // specific job/project site, distinct from the general "site" field above
  drivingRecordRequired      Boolean?
  liftOperatorCertifications String?
  siteSpecificsNeeded        Boolean?
  fitTestNeeded              Boolean?
  additionalTrainingsNeeded  String?
  safetyEquipmentNeeded      String? // comma-separated: N/A, H2S monitor, Four Gas, Harness, Lanyard, Hard Hat, Safety glasses, Gloves, Goggles
  additionalEquipmentNeeds   String?

  // Onboarding lifecycle: DRAFT, SUBMITTED, HR_REVIEW, RATES_ASSIGNED, APPROVED
  status String @default("DRAFT")
  source String @default("LINK") // LINK or EXCEL

  // HR's review checkpoint. Advances status SUBMITTED -> HR_REVIEW; unchecking
  // reverts HR_REVIEW -> SUBMITTED. Same on/off shape as `approved` below.
  hrReviewed   Boolean   @default(false)
  hrReviewedAt DateTime?

  // Not a toggle -- computed from payRate + billRate both being set (see
  // syncRatesStatus in admin/actions.ts). Timestamp only, for the record.
  ratesAssignedAt DateTime?

  // Overall approval (per-column approval workflow comes in Phase 3)
  approved   Boolean   @default(false)
  approvedAt DateTime?

  certifications       Certification[]
  documents            Document[]
  onboardingLink       OnboardingLink?
  documentGrants       EmployeeDocumentGrant[]
  statusChangeRequests StatusChangeRequest[]
  travelRequests       TravelRequest[]
  timesheetToken       EmployeeTimesheetToken?
  timesheets           Timesheet[]
}

// Multiple certifications per employee.
model Certification {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  name       String
  issuer     String?
  issuedDate DateTime?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
}

// Uploaded documents (license scan, SSN card, TWIC, safety council, cert PDFs, etc.)
model Document {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  // Logical category: LICENSE, SSN, TWIC, SAFETY_COUNCIL, CERTIFICATION, OTHER
  category   String
  label      String? // optional human label (e.g. cert name)
  fileName   String // original filename
  storageKey String // key/path in the storage backend
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

// Application users (staff). Distinct from Employee onboarding records.
// role is one of the values in src/lib/rbac.ts ROLES.
model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  role         String               @default("EMPLOYEE")
  passwordHash String
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  sessions     Session[]
  sites        UserSite[]
  resetTokens  PasswordResetToken[]

  // The single designated recipient for admin-facing invoice notifications
  // (final-approval alerts, "Email Admins" nudges). At most one user should
  // have this set true at a time -- enforced in the server action, not the DB.
  receivesInvoiceAdminEmails Boolean @default(false)

  // The single designated recipient for onboarding-submission emails,
  // falling back to every active HR user if nobody's designated. Same
  // single-recipient convention as receivesInvoiceAdminEmails above.
  receivesOnboardingHrEmails Boolean @default(false)

  // Per-user override granting full view/download access to every
  // employee's documents, regardless of role -- managed from the Users
  // page. Unlike the single-recipient fields above, any number of users
  // may have this set at once. Equivalent to the "library" column
  // permission, just granted to a specific person instead of a role.
  hasFullDocumentAccess Boolean @default(false)

  documentGrantsReceived EmployeeDocumentGrant[] @relation("DocumentGrantUser")
  documentGrantsMade     EmployeeDocumentGrant[] @relation("DocumentGrantGrantedBy")
}

// A one-off grant letting a specific user view/download one employee's
// documents (Details + Documents section on the employee page), independent
// of their role's default access or any Project Lead/Manager assignment.
// View/download only -- never implies edit rights on that employee.
model EmployeeDocumentGrant {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("DocumentGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User     @relation("DocumentGrantGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([employeeId, userId])
}

// Site-level (row) access. A non-admin user with one or more UserSite rows is
// restricted to employees at those sites. A user with no rows is unrestricted.
// Admins / Super Admins are always unrestricted regardless of rows.
model UserSite {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   String

  @@unique([userId, site])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A single-use, expiring token for the "forgot password" flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Per-column access for a role. level: HIDDEN | VIEW | EDIT.
// canApprove marks the role responsible for approving that column.
model ColumnAccess {
  id         String  @id @default(cuid())
  role       String
  columnKey  String
  level      String  @default("VIEW")
  canApprove Boolean @default(false)

  @@unique([role, columnKey])
}

// Per-role visibility for a top-level nav item. level: whether the role sees
// (and can access) that section of the app. Super Admin always sees everything
// and is not editable here, same rule as ColumnAccess.
model NavAccess {
  id      String  @id @default(cuid())
  role    String
  navKey  String
  visible Boolean @default(false)

  @@unique([role, navKey])
}

// A unique tokenized link sent to an employee to complete onboarding.
model OnboardingLink {
  id         String    @id @default(cuid())
  token      String    @unique
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  usedAt     DateTime?
}

// A billing client for a site/project. Invoices are sent to Client.email.
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String
  site      String
  createdAt DateTime  @default(now())
  invoices  Invoice[]

  @@unique([email, site])
}

// An invoice built by a Project Manager, reviewed by an Account Manager, and
// given final sign-off (which triggers the client email) by an Admin.
// status: DRAFT | SUBMITTED | AM_APPROVED | ADMIN_APPROVED | SENT | PAID
model Invoice {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  site             String
  invoiceNumber    String?
  jobNumber        String?
  poNumber         String?
  status           String    @default("DRAFT")
  createdByUserId  String
  rejectionReason  String?
  rejectedByUserId String?
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sentAt           DateTime?
  paidAt           DateTime?

  // Denormalized (like InvoiceComment.authorName) so the invoices list can
  // show who last touched it without joining to User.
  lastModifiedByUserId String?
  lastModifiedByName   String?

  lineItems   InvoiceLineItem[]
  attachments InvoiceAttachment[]
  comments    InvoiceComment[]
}

// Free-form invoice line (description + amount), entered by the Project Manager.
model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  amount      Float
  createdAt   DateTime @default(now())
}

// Files attached to an invoice (uploaded timesheets, generated grid exports, etc).
// category: TIMESHEET | GRID_EXPORT | OTHER
model InvoiceAttachment {
  id         String   @id @default(cuid())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  category   String
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
}

// A comment left on an invoice by anyone who can view it (PM/PL on their
// site, AM, or admin) -- a simple running discussion thread.
model InvoiceComment {
  id           String   @id @default(cuid())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  authorUserId String
  authorName   String
  message      String
  createdAt    DateTime @default(now())
}

// One row per scheduled notification already sent (weekly expiry digest,
// hire-date anniversaries). The unique key is claimed before sending, so
// only one app instance ever sends a given notification.
model NotificationLog {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
}

// A request to change an employee's status/rate/site/job assignment, filled
// out by the Project Lead/Manager assigned to them (or an Admin) as the
// third step of the onboarding flow, shown only after Project Lead Details
// have been saved. On submit, `newSite` is written onto Employee.site and
// the row is kept as a permanent record of the change (who/why/when).
model StatusChangeRequest {
  id                     String    @id @default(cuid())
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId             String
  effectiveDate          DateTime?
  reasonForChange        String?
  employmentType         String? // comma-separated, same options as Employee.employmentType
  fromJobNumber          String?
  toJobNumber            String?
  newSite                String? // applied onto Employee.site when the form is submitted
  detailsOfChange        String?
  drivingRecordRequired  Boolean?
  creditCardRequested    Boolean?
  creditCardApprovedByGm Boolean?
  deactivateEmailAccess  Boolean?
  deactivateAmexCard     Boolean?
  requestingManagerName  String?
  submittedByUserId      String
  submittedByName        String
  createdAt              DateTime  @default(now())
}

// A travel request pre-filled from the employee's grid data and completed by
// their Project Lead/Manager (or an Admin). Emailed to the Travel
// Administrator on submit; each row is a permanent record of the request.
model TravelRequest {
  id                     String    @id @default(cuid())
  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId             String
  jobNumber              String?
  clientName             String?
  fullName               String?
  dateOfBirth            DateTime?
  gender                 String?
  knownTravelerNumber    String?
  phone                  String?
  email                  String?
  flightNeeded           Boolean?
  travelType             String?
  dateOfDeparture        DateTime?
  dateOfReturn           DateTime?
  departureLocation      String?
  destinationLocation    String?
  seatPreference         String?
  timePreference         String?
  rentalCarNeeded        Boolean?
  rentalCarType          String?
  rentalCarJustification String?
  pickupLocation         String?
  dropoffLocation        String?
  dateOfPickup           DateTime?
  dateOfCarReturn        DateTime?
  billingManagerEmail    String?
  additionalComments     String?
  submittedByUserId      String
  submittedByName        String
  createdAt              DateTime  @default(now())
}

// A persistent (reusable, not one-time) token letting one employee reach a
// timesheet-only self-service portal at /timesheet/[token] -- no password,
// no access to anything else in the app. Admin/Super Admin generate it from
// the employee page and can revoke/regenerate it if it leaks.
model EmployeeTimesheetToken {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String    @unique
  token      String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
}

// One weekly timesheet for one employee, matching the Time & Expense Report
// template. Day-level hours/expenses live on TimesheetDay (not here) so
// reporting can filter/group by job number and date at the day level -- a
// single week can span more than one job number.
model Timesheet {
  id                 String         @id @default(cuid())
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId         String
  weekEnding         DateTime // the Sunday the week ends on
  clientName         String?
  location           String?
  jobNumber          String? // primary/default job number for the week
  notes              String?
  advancedToEmployee Float?
  clientApprovalName String?
  clientApprovedAt   DateTime?
  employeeSignedAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  days               TimesheetDay[]

  @@unique([employeeId, weekEnding])
}

// One calendar day within a Timesheet, mirroring the template's two daily
// grids (billable time + mileage, and expenses).
model TimesheetDay {
  id                 String    @id @default(cuid())
  timesheet          Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  timesheetId        String
  date               DateTime
  jobNumber          String? // per-day override; falls back to Timesheet.jobNumber when reporting
  afeNumber          String?
  woNumber           String?
  details            String?
  stHours            Float?
  otHours            Float?
  ptoHours           Float?
  vacationHours      Float?
  holidayHours       Float?
  perDiem            Float?
  mileageDriven      Float?
  mileageAmount      Float?
  lodging            Float?
  meals              Float?
  airfare            Float?
  fuel               Float?
  carRental          Float?
  gasoline           Float?
  parking            Float?
  misc               Float?
  expenseDescription String?

  @@unique([timesheetId, date])
}
